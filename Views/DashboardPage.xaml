<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuAppLogradouros.Views.DashboardPage"
             Title="Painel Principal">
    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            
            <!-- Banner de Identidade Visual com Nome e Logo Obrigatórios -->
            <Frame BackgroundColor="#1E1E2F" Padding="20" CornerRadius="16" HasShadow="True">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <!-- Imagem / Logo da Aplicação contendo o nome do aluno -->
                    <Image Source="dotnet_bot.png" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" />
                    
                    <Label Text="MeuAppLogradouros - Enterprise" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="#00D26A"/>
                    
                    <Label Text="Desenvolvedor: Gabriel Ribeiro Couto" 
                           FontSize="15" 
                           FontAttributes="Italic" 
                           HorizontalOptions="Center" 
                           TextColor="#FFFFFF"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Cards de Métricas com Ícones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Frame Grid.Column="0" BackgroundColor="#2A2D3E" Padding="15" CornerRadius="12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📊 Total de Itens" FontSize="13" TextColor="#A0AEC0"/>
                        <Label x:Name="LblTotalItens" Text="1" FontSize="26" FontAttributes="Bold" TextColor="#38BDF8"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" BackgroundColor="#2A2D3E" Padding="15" CornerRadius="12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🔒 Status DB" FontSize="13" TextColor="#A0AEC0"/>
                        <Label Text="Conectado" FontSize="20" FontAttributes="Bold" TextColor="#4ADE80"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Botões de Acesso Rápido com Ícones / Emojis -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="📍 Gerenciar Logradouros (CRUD)" 
                        Clicked="OnGoToLogradourosClicked" 
                        BackgroundColor="#3B82F6" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="55" 
                        CornerRadius="10"/>

                <Button Text="⚙️ Configurações do Sistema" 
                        Clicked="OnGoToSettingsClicked" 
                        BackgroundColor="#475569" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="55" 
                        CornerRadius="10"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>