<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuAppLogradouros.Views.DashboardPage"
             Title="Painel Principal">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Cartão Principal com a Imagem SVG que contém a logo + nome do desenvolvedor -->
            <Frame BackgroundColor="#1E293B" CornerRadius="16" Padding="20" BorderColor="#10B981">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="logo_gabriel.png" WidthRequest="340" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center"/>
                    <Label Text="Desenvolvedor: Gabriel Ribeiro Couto" TextColor="White" FontAttributes="Italic" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Botões de Acesso aos Módulos -->
            <Button Text="⏱️ Controle Entrada/Saída (Academia)" Clicked="OnAcessoClicked" BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" HeightRequest="50"/>
            <Button Text="👨‍🎓 Gerenciar Alunos (CRUD)" Clicked="OnAlunosClicked" BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" HeightRequest="45"/>
            <Button Text="👔 Gerenciar Colaboradores (CRUD)" Clicked="OnColaboradoresClicked" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" HeightRequest="45"/>
            <Button Text="📍 Gerenciar Logradouros (CRUD)" Clicked="OnLogradourosClicked" BackgroundColor="#3B82F6" TextColor="White" FontAttributes="Bold" HeightRequest="45"/>
            <Button Text="⚙️ Configurações do Sistema" Clicked="OnSettingsClicked" BackgroundColor="#475569" TextColor="White" FontAttributes="Bold" HeightRequest="45"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>