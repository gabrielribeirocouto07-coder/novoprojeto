<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuAppLogradouros.Views.LogradouroDetailPage"
             Title="Detalhes do Logradouro">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Nome do Logradouro:" FontAttributes="Bold"/>
            <Entry x:Name="TxtNome" Placeholder="Ex: Gabriel Ribeiro Couto" />

            <Label Text="Bairro:" FontAttributes="Bold"/>
            <Entry x:Name="TxtBairro" Placeholder="Ex: Abc Bolinhas" />

            <Label Text="CEP:" FontAttributes="Bold"/>
            <Entry x:Name="TxtCep" Placeholder="Ex: 88500-000" Keyboard="Numeric"/>

            <Button Text="Salvar" 
                    Clicked="OnSaveClicked" 
                    BackgroundColor="#2196F3" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    Margin="0,10,0,0"/>

            <Button x:Name="BtnExcluir" 
                    Text="Excluir" 
                    Clicked="OnDeleteClicked" 
                    BackgroundColor="#F44336" 
                    TextColor="White" 
                    FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>