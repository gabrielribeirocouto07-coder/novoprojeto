<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MeuAppLogradouros.Views"
       x:Class="MeuAppLogradouros.AppShell"
       FlyoutBehavior="Flyout">

    <FlyoutItem Title="Dashboard" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Logradouros" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:LogradouroListPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Alunos" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:AlunoListPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Colaboradores" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:ColaboradorListPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

</Shell>