<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MeuAppLogradouros.Views"
       x:Class="MeuAppLogradouros.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Dashboard" Icon="dotnet_bot.png" ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Logradouros" Icon="dotnet_bot.png" ContentTemplate="{DataTemplate views:LogradouroListPage}" />
        <ShellContent Title="Alunos" Icon="dotnet_bot.png" ContentTemplate="{DataTemplate views:AlunoListPage}" />
        <ShellContent Title="Colaboradores" Icon="dotnet_bot.png" ContentTemplate="{DataTemplate views:ColaboradorListPage}" />
        <ShellContent Title="Configurações" Icon="dotnet_bot.png" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>