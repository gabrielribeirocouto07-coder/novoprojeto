<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MeuAppLogradouros.Views"
       x:Class="MeuAppLogradouros.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <!-- Aba 1: Dashboard -->
        <ShellContent Title="Dashboard"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />

        <!-- Aba 2: Logradouros (CRUD) -->
        <ShellContent Title="Logradouros"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:LogradouroListPage}" />

        <!-- Aba 3: Configurações (Novo Requisito) -->
        <ShellContent Title="Configurações"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>